# ===== jins-bot (Render): бот + мини-апп =====
# Обязательные
BOT_TOKEN=123456:replace_with_bot_token
DATABASE_URL=postgresql://user:pass@host:5432/dbname      # ОБЩАЯ БД: то же значение должно быть у jins-forum
OWNER_ID=123456789

# Адрес этого сервиса (Render подставляет RENDER_EXTERNAL_URL сам; WEBAPP_URL — если нужен свой домен)
# WEBAPP_URL=https://your-bot.onrender.com
# MINIAPP_LINK=https://t.me/mybot/app

# ИИ-поддержка (необязательно; то же значение можно указать и у форума)
# GEMINI_API_KEY=

# Юзербот гаранта (my.telegram.org -> API development tools)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_api_hash
# RUN_USERBOT_IN_WEB=true

# Публичный API, бот в группах и прочее — см. README.txt, API.md, group_watch.py
# API_CORS_ORIGINS=*
# API_TRUST_PROXY=1
# GROUP_WATCH=1
