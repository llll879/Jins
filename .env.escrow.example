# Set these only in the private environment of the separate MTProto worker service.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_api_hash
USERBOT_SESSION_STRING=replace_with_private_string_session

# Shared with the main bot and PostgreSQL
DATABASE_URL=postgresql://...
BOT_TOKEN=123456:replace_with_bot_token
OWNER_ID=123456789

# Configure in the admin panel after the worker is online and reserve is sufficient.
# ESCROW_AUTO_CONVERT is intentionally not provided: converting a gift destroys it.
