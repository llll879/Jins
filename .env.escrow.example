# Обязательные переменные основного сервиса (bot.py)
BOT_TOKEN=123456:replace_with_bot_token
DATABASE_URL=postgresql://...
OWNER_ID=123456789

# Для подключения юзербота через бота (my.telegram.org → API development tools)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_api_hash

# Необязательно: false — не запускать воркер внутри основного сервиса (если он работает отдельным сервисом).
# RUN_USERBOT_IN_WEB=true

# Сессию вводить не нужно: аккаунт подключается в боте (/admin → «Юзербот гаранта»)
# и хранится в БД. USERBOT_SESSION_STRING — только запасной вариант.
# USERBOT_SESSION_STRING=
