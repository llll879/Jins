# Обязательные переменные основного сервиса (bot.py)
BOT_TOKEN=123456:replace_with_bot_token
DATABASE_URL=postgresql://...
OWNER_ID=123456789

# Для подключения юзербота через бота (my.telegram.org → API development tools)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_api_hash

# Необязательно: false — не запускать воркер внутри основного сервиса (если он работает отдельным сервисом).
# RUN_USERBOT_IN_WEB=true

# Сессию вводить не нужно: аккаунт подключается в боте (/admin → «Юзербот гаранта»)
# и хранится в БД. USERBOT_SESSION_STRING — только запасной вариант.
# USERBOT_SESSION_STRING=

# Публичный API (необязательно, см. API.md)
# API_CORS_ORIGINS=*            # значение Access-Control-Allow-Origin для /api/v1
# API_TRUST_PROXY=1             # брать IP клиента из X-Forwarded-For (за Render/nginx); 0 — отключить
# API_WEBHOOK_ALLOW_HTTP=0      # 1 — разрешить http:// для вебхуков (только отладка)
# API_WEBHOOK_ALLOW_PRIVATE=0   # 1 — разрешить внутренние адреса вебхуков (только отладка)

# Бот в группах: сбор объявлений и предупреждения о скамерах (необязательно, см. group_watch.py)
# GROUP_WATCH=1                 0 — выключить модуль целиком
# GROUP_AD_MIN_LEN=40           минимальная длина сообщения-кандидата
# GROUP_AD_MIN_CONF=0.6         минимальная уверенность ИИ, что это объявление (0..1)
# GROUP_AD_DAILY_LIMIT=3        максимум авто-заявок от одного человека в сутки
# GROUP_SCAM_COOLDOWN=0         пауза (сек) между предупреждениями об одном человеке; 0 — после каждого сообщения
# GROUP_WARN_MINUS=0            1 — предупреждать и о «ненадёжных» (много жалоб)
# GROUP_AD_PLATE=📥 Из чата «{chat}»
